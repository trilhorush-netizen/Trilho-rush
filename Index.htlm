 const ty=y+33*z,kx=x0+w*S.sat/200;rr(x0-10*z,ty-4*z,w+20*z,8*z,4*z,'#1b1448');rr(x0-10*z,ty-4*z,kx-x0+10*z,8*z,4*z,'#7a5cff');g.fillStyle='#ffd23f';g.beginPath();g.arc(kx,ty,9*z,0,7);g.fill();g.lineWidth=2;g.strokeStyle=OL;g.stroke();
