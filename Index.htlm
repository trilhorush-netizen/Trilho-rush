function lockIc(x,y,r){g.save();g.translate(x,y);g.strokeStyle='#cfd3e0';g.lineWidth=r*.28;g.beginPath();g.arc(0,-r*.2,r*.5,M.PI,0);g.stroke();rr(-r*.7,-r*.1,r*1.4,r,r*.2,'#ffd23f',1);g.fillStyle='#241b5c';g.beginPath();g.arc(0,r*.35,r*.14,0,7);g.fill();g.restore()}
