function rcode(){const a='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<5;i++)s+=a[(R()*a.length)|0];return s}
function cleanCode(v){return(v||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,8)}
