 for(let i=0;i<4;i++){const y=H*.17+i*(78*z),x=cx-140*z,has=i<INFL.length;rr(x,y+4*z,280*z,66*z,16*z,'rgba(0,0,0,.35)');rr(x,y,280*z,66*z,16*z,has?LG(0,y,0,y+66*z,'#4a3da8','#241b5c'):'rgba(255,255,255,.07)',has);
  if(has){badge(x+34*z,y+33*z,17*z);rbow(INFL[i],cx+22*z,y+42*z,28*z)}else{tp('Espa\u00e7o para parceiros',cx,y+39*z,15*z,'#9a93c8')}}
