function pv(x,y0,f,ci,oi){g.save();g.translate(x,y0);g.scale(f,f);front(skinOf(ci,oi),U*.68,T);g.restore()}
try{Object.assign(S,JSON.parse(localStorage.getItem('trilho_set')||'{}'))}catch(e){}
if(!(S.q>=0&&S.q<=3))S.q=2;if(!(S.ch>=0&&S.ch<8))S.ch=0;if(!Array.isArray(S.oo)||S.oo.length<8)S.oo=[0,0,0,0,0,0,0,0];if(!(S.sat>=0&&S.sat<=200))S.sat=100;if(!(S.map>=0&&S.map<5))S.map=0;if(!(typeof S.cc=='string'&&/^#[0-9a-f]{6}$/i.test(S.cc)))S.cc=null;S.ko=S.ko?1:0;SK=skinOf(S.ch,S.oo[S.ch]||0);fit();
function sv(){try{localStorage.setItem('trilho_set',JSON.stringify(S))}catch(e){}}
function aud(){if(AC){if(AC.state=='suspended')AC.resume();return}try{const C=window.AudioContext||window.webkitAudioContext;AC=new C();mG=AC.createGain();mG.gain.value=.16;mG.connect(AC.destination);sG=AC.createGain();sG.gain.value=.5;sG.connect(AC.destination)}catch(e){AC=null}}
function tone(f,t0,d,ty,v,dst,f2){const o=AC.createOscillator(),q=AC.createGain();o.type=ty;o.frequency.setValueAtTime(f,t0);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t0+d);q.gain.setValueAtTime(v,t0);q.gain.exponentialRampToValueAtTime(.001,t0+d);o.connect(q);q.connect(dst||sG);o.start(t0);o.stop(t0+d+.03)}
function noise(t0,d,v,f0,f1,dst){const n=(AC.sampleRate*d)|0,b=AC.createBuffer(1,n,AC.sampleRate),ch=b.getChannelData(0);for(let i=0;i<n;i++)ch[i]=R()*2-1;const sr=AC.createBufferSource();sr.buffer=b;const fl=AC.createBiquadFilter();fl.type='bandpass';fl.frequency.setValueAtTime(f0,t0);fl.frequency.exponentialRampToValueAtTime(f1,t0+d);const q=AC.createGain();q.gain.setValueAtTime(v,t0);q.gain.exponentialRampToValueAtTime(.001,t0+d);sr.connect(fl);fl.connect(q);q.connect(dst||sG);sr.start(t0)}
function sfx(k){if(!AC)return;try{const t=AC.currentTime,mv=S.mov;
 if(k=='lane'){if(mv)noise(t,.14,.5,500,2200)}else if(k=='jump'){if(mv)tone(300,t,.2,'square',.1,0,720)}else if(k=='roll'){if(mv)noise(t,.3,.55,1800,300)}else if(k=='land'){if(mv)tone(110,t,.1,'sine',.35,0,60)}
 else if(k=='coin'){tone(988,t,.08,'square',.1);tone(1319,t+.07,.2,'square',.1)}
 else if(k=='bonk'){noise(t,.16,.7,700,200);tone(200,t,.16,'triangle',.3,0,90)}
 else if(k=='over'){noise(t,.4,.8,900,90);tone(140,t,.3,'sawtooth',.22,0,45);[392,330,262,196].forEach((f,i)=>tone(f,t+.25+i*.17,.3,'triangle',.25))}
 else if(k=='start'){[523,659,784,1047].forEach((f,i)=>tone(f,t+i*.08,.2,'square',.1))}
 else if(k=='tick'){tone(660,t,.12,'square',.12)}
 else if(k=='horn'){for(const d of[0,.62]){tone(420,t+d,.4,'square',.07);tone(530,t+d,.4,'square',.07)}}
 else if(k=='train'){noise(t,1.1,.8,140,520);tone(70,t,1.1,'sawtooth',.16,0,48)}}catch(e){}}
const BASS=[55,55,65.4,49,55,55,73.4,65.4],ARP=[[220,261.6,329.6,392],[196,246.9,293.7,392],[174.6,220,261.6,329.6],[196,246.9,293.7,370]];
function musTick(){if(!AC||!S.mus||!(st=='play'||st=='menu'||st=='count')){nxt=0;return}try{const t=AC.currentTime,sp=60/132/2;if(nxt<t)nxt=t+.05;
 while(nxt<t+.35){const i=step%32,ch=ARP[(i>>3)&3];
  if(i%2==0)tone(BASS[(i>>2)&7],nxt,sp*1.8,'sawtooth',.45,mG);
  tone(ch[i%4]*2,nxt,sp*.9,'square',.1,mG);
  if(i%4==0)tone(120,nxt,.13,'sine',.9,mG,40);
  if(i%2==1)noise(nxt,.05,.2,6000,8000,mG);
  step++;nxt+=sp}}catch(e){}}
function gear(x,y,r){g.save();g.translate(x,y);g.fillStyle='rgba(255,255,255,.92)';for(let i=0;i<8;i++){g.rotate(M.PI/4);g.fillRect(-r*.16,-r*1.22,r*.32,r*.5)}g.beginPath();g.arc(0,0,r*.95,0,7);g.fill();g.fillStyle='rgba(30,20,80,.95)';g.beginPath();g.arc(0,0,r*.4,0,7);g.fill();g.restore()}
