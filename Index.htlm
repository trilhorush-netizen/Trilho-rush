const unEl=document.getElementById('un'),pwEl=document.getElementById('pw');let savePw=0,savedH='',dayNeed=0;try{savePw=+localStorage.getItem('trilho_su')||0;savedH=savePw?localStorage.getItem('trilho_sh')||'':''}catch(e){}
async function sha(t){t='trilho:'+t;try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}catch(e){let h=5381;for(const c of t)h=(h*33^c.charCodeAt(0))>>>0;return'f'+h.toString(16)}}
try{user=localStorage.getItem('trilho_user')||'';rk=(JSON.parse(localStorage.getItem('trilho_rank')||'[]')||[]).filter(e=>e&&typeof e.n=='string'&&typeof e.t=='number'&&e.t>=0)}catch(e){}
const RANK_URL='https://trilho-rush-default-rtdb.firebaseio.com';/* URL do Firebase Realtime Database (sem barra no final) */
let gExtra=[],pollT=0,lastY=0,dragSat=null,rkY=0,myId='',myPhoto='',myImg=null;const IMGS={};
try{myId=localStorage.getItem('trilho_id')||'';if(!myId){myId='u'+Date.now().toString(36)+Math.random().toString(36).slice(2,8);localStorage.setItem('trilho_id',myId)}myPhoto=localStorage.getItem('trilho_photo')||''}catch(e){myId=myId||'u'+Math.random().toString(36).slice(2,10)}
if(myPhoto){myImg=new Image();myImg.src=myPhoto}
const phEl=document.getElementById('ph');
if(phEl)phEl.addEventListener('change',()=>{const f=phEl.files&&phEl.files[0];if(!f)return;const fr=new FileReader();fr.onload=()=>{const im=new Image();im.onload=()=>{const c=document.createElement('canvas');c.width=c.height=72;const x=c.getContext('2d'),m=M.min(im.width,im.height);x.drawImage(im,(im.width-m)/2,(im.height-m)/2,m,m,0,0,72,72);try{myPhoto=c.toDataURL('image/jpeg',.7);localStorage.setItem('trilho_photo',myPhoto)}catch(e){}myImg=new Image();myImg.src=myPhoto};im.src=fr.result};fr.readAsDataURL(f);phEl.value=''});
addEventListener('wheel',e=>{if(st=='rank')rkY+=e.deltaY*.5},{passive:true});
function LIST(){return gOK?gRk:[]}
function validRow(d){return d&&typeof d.n=='string'&&typeof d.t=='number'&&d.t>=0&&d.t<3600}
function imgOf(id,src){if(!src)return null;let e=IMGS[id];if(!e||e.src!==src){e=new Image();e.src=src;IMGS[id]=e}return e.complete&&e.naturalWidth?e:null}
async function rj(path,opt){const r=await fetch(RANK_URL+path,opt);if(!r.ok)throw new Error(r.status);return r.json()}
async function fetchRank(){if(!RANK_URL){gOK=0;return}try{let d;try{d=await rj('/rank2.json?orderBy=%22t%22&limitToLast=70')}catch(e){d=await rj('/rank2.json')}
 const a=[];if(d)for(const k in d){const v=d[k];if(validRow(v))a.push({id:k,n:v.n,t:v.t,p:v.p||'',ts:v.ts||0})}
 a.sort((x,y)=>y.t-x.t||x.ts-y.ts);gRk=a.slice(0,50);gExtra=a.slice(50);const mm=a.find(e=>e.id==myId);gBest=mm?mm.t:-1;gOK=1}catch(e){gOK=0}}
async function pushGlobal(t){const gw0=gWrote;if(!RANK_URL)return;try{await fetchRank();if(!gOK)return;
 const me=gRk.find(e=>e.id==myId)||gExtra.find(e=>e.id==myId);
 if(me&&me.t>=t)return;
 if(!gRk.some(e=>e.id==myId)&&gRk.length>=50&&t<=gRk[49].t)return;
 const row={n:user,t,ts:Date.now()};if(myPhoto&&myPhoto.length<12000)row.p=myPhoto;
 gWrote=gw0||{prev:me?{n:me.n,t:me.t,ts:me.ts,p:me.p}:null};
 await rj('/rank2/'+myId+'.json',{method:'PUT',body:JSON.stringify(row)});
 await fetchRank();
 }catch(e){gWrote=null;gMsg='Falha ao enviar ao Top Global'}}
async function pushLive(t){if(!RANK_URL||!user||respUsed)return;if(liveBusy){livePend=t;return}if(!gOK){fetchRank();return}
 if(t<=gBest)return;if(gRk.length>=50&&!gRk.some(e=>e.id==myId)&&t<=gRk[49].t)return;
 liveBusy=1;try{const me=gRk.find(e=>e.id==myId)||gExtra.find(e=>e.id==myId);if(!gWrote)gWrote={prev:me?{n:me.n,t:me.t,ts:me.ts,p:me.p}:null};
  const row={n:user,t,ts:Date.now()};if(myPhoto&&myPhoto.length<12000)row.p=myPhoto;
  await rj('/rank2/'+myId+'.json',{method:'PUT',body:JSON.stringify(row)});gBest=t;
  gRk=gRk.filter(e=>e.id!=myId);gRk.push({id:myId,n:user,t,p:row.p||'',ts:row.ts});gRk.sort((x,y)=>y.t-x.t||x.ts-y.ts);gRk=gRk.slice(0,50)}catch(e){}
 liveBusy=0;if(livePend>gBest){const p=livePend;livePend=0;pushLive(p)}}
function undoGlobal(){if(!RANK_URL||!gWrote)return;const w=gWrote;gWrote=null;if(w.prev){const r={n:w.prev.n,t:w.prev.t,ts:w.prev.ts};if(w.prev.p)r.p=w.prev.p;rj('/rank2/'+myId+'.json',{method:'PUT',body:JSON.stringify(r)}).then(fetchRank).catch(()=>{})}else rj('/rank2/'+myId+'.json',{method:'DELETE'}).then(fetchRank).catch(()=>{})}
function goBack(b){if(b=='count'){cdT=3;cdLast=4;st='count';sfx('tick')}else st=b}
function applySat(){cv.style.filter=S.sat==100?'':'saturate('+(S.sat/100)+')'}
function satFrom(x){const b=dragSat;if(!b)return;S.sat=M.round(M.max(0,M.min(200,(x-b.tx0)/b.tw*200))/5)*5;applySat()}
