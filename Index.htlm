  else{g.fillStyle='#ffb0c4';g.beginPath();g.ellipse(x,y0,28*u,32*u,0,M.PI,0);g.fill();g.strokeStyle='#e0708f';g.lineWidth=1.5;for(let i=-3;i<=3;i++){g.beginPath();g.moveTo(x,y0);g.lineTo(x+i*8*u,y0-30*u+M.abs(i)*3*u);g.stroke()}g.fillStyle='#fff';g.beginPath();g.arc(x,y0-8*u,5*u,0,7);g.fill()}
 }}
