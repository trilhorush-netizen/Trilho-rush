function isOwner(e){return OWNER_ID?e.id==OWNER_ID:(e.n||'').toLowerCase()=='martins'}
function crown(x,y,w){const h=w*.8;g.save();g.translate(x,y+M.sin(T*4)*1.5);g.fillStyle='#ffd23f';g.strokeStyle='#b8860b';g.lineWidth=M.max(1,w*.07);g.lineJoin='round';g.beginPath();g.moveTo(-w/2,h/2);g.lineTo(-w/2,-h*.15);g.lineTo(-w*.25,h*.12);g.lineTo(0,-h/2);g.lineTo(w*.25,h*.12);g.lineTo(w/2,-h*.15);g.lineTo(w/2,h/2);g.closePath();g.fill();g.stroke();g.fillStyle='#e8404f';g.beginPath();g.arc(0,h*.2,w*.07,0,7);g.fill();g.fillStyle='#4fa3ff';for(const q of[-.3,.3]){g.beginPath();g.arc(q*w,h*.28,w*.05,0,7);g.fill()}g.restore()}

