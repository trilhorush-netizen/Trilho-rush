 g.strokeStyle='rgba(255,255,255,.55)';g.lineWidth=1.6*k;g.lineCap='round';for(let i=-2;i<=2;i++){const q=(T*5+i*.37)%1;g.beginPath();g.moveTo(i*14*k,-6*k+q*16*k);g.lineTo(i*14*k,-1*k+q*22*k);g.stroke()}}
