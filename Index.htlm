function cmode(ln){
const r=R(),h=M.min(.2,(speed-720)/3500);
if(r<.1&&dist>6000){ln.fill('');cmC=(R()*3)|0;ln[cmC]='tramp';return 20}if(r<.22+h){ln.fill('');return 10+((R()*4)|0)}
if(r<.5){ln[pf+1]='';return 1}
if(r<.62){ln[pf+1]='high';return 2}
return 0}
function mkCoins(ln,m){
const C=(l,z,yy)=>cs.push({l,z,y:yy,got:0}),Z=2600;
if(m==20){for(const l of[-1,0,1])if(l!=cmC-1)for(let j=0;j<7;j++)C(l,Z+30+j*105,28);return 700}
if(m==1){for(let j=0;j<3;j++)C(pf,Z+100+j*120,28);return 360}
if(m==2){for(let j=0;j<3;j++)C(pf,Z-50+j*50,28);return 80}
if(m==10){const nr=pT>=180?4:3;for(let j=0;j<nr;j++)for(let l=-1;l<2;l++)C(l,Z+j*110,28);return 260+(nr-3)*110}
if(m==11){(R()<.5?[-1,0,1]:[1,0,-1]).forEach((l,j)=>C(l,Z+j*360,28));return 760}
if(m==12){const c=(R()*3|0)-1,d=c<1?c+1:c-1;[30,82,134].forEach(yy=>C(c,Z,yy));for(let j=0;j<3;j++)C(d,Z+j*120,28);return 300}
if(m==13){const a=(R()*3|0)-1,b=a<1?a+1:a-1;for(let j=0;j<3;j++){C(a,Z+j*120,28);C(b,Z+340+j*120,28)}return 600}
const ok=[0,1,2].filter(i=>i-1!=pf&&(ln[i]==''||ln[i]=='low'));
if(!ok.length)return 0;
const i=ok[(R()*ok.length)|0],l=i-1;
if(ln[i]=='low'){for(let j=0;j<3;j++)C(l,Z-100+j*100,28+95*M.sin(M.PI*j/2));return 200}
if(R()<.5){for(let j=0;j<3;j++)C(l,Z+j*120,28);return 300}
[30,82,134].forEach(yy=>C(l,Z,yy));return 20}
function spawn(){
 if(dist>2500&&dist-cmD>9000&&R()<.13){cmD=dist;const cc=(SPC?TS:TM>1?TP2[TM]:TC)[(R()*4)|0];for(const l of[-1,1])obs.push({k:'car',l,z:2600,len:780,f:0,h:90,c:cc,sd:(R()*997)|0});for(let j=0;j<7;j++)cs.push({l:0,z:2650+j*105,y:28,got:0});for(let j=0;j<4;j++){cs.push({l:-1,z:2680+j*190,y:122,got:0});cs.push({l:1,z:2775+j*190,y:122,got:0})}mvNext=0;nextSp=dist+780+speed*.5+200;return}
 const pb=.28+M.min(.25,(speed-720)/3000),mvS=mvNext&&speed>700;
 pf=M.max(-1,M.min(1,pf+((R()*3)|0)-1));
 const ln=[0,1,2].map(i=>{if(i-1==pf){return PFT[(R()*PFT.length)|0]}
  return R()<pb?'train':OT[(R()*OT.length)|0]});
 const cm=cmode(ln);let mx=40;
 ln.forEach((k,i)=>{if(!k)return;const rm=k=='tramp'||(k=='train'&&!mvS&&R()<.25),tr=k=='train'||k=='tramp',len=k=='tramp'?640:rm?(430+((R()*300)|0)):tr?(mvS?420:300)+(R()*400)|0:LN[k]||20;
  const mvT=tr&&mvS&&!rm,an=mvT&&(TM==2||TM==4),ln2=an?130:len;obs.push({sd:(R()*997)|0,k:an?'animal':tr?'train':k,an:an?TM:0,ramp:rm?1:0,l:i-1,z:2600,len:ln2,f:mvT?-.5:0,c:(SPC?TS:TM>1?TP2[TM]:TC)[(R()*4)|0]});mx=M.max(mx,ln2)});
 mx=M.max(mx,mkCoins(ln,cm));const fr=[];if(ln[pf+1]==''&&cm<10&&R()<.7)for(let j=0;j<3;j++)cs.push({l:pf,z:2600+j*90,y:28,got:0});
 if(fr.length&&R()<.8){const i=fr[(R()*fr.length)|0],lo=ln[i]=='low',z0=2600-(lo?175:0);
  for(let j=0;j<6;j++)cs.push({l:i-1,z:z0+j*70,y:28+(lo?95*M.sin(M.PI*j/5):0),got:0})}
 mvNext=R()<.35;nextSp=dist+mx+speed*.32+110+(mvNext?300:0);
}
