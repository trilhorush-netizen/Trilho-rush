function jump(){if(stand||(vy<=0&&T-lastSt<.22)){vy=700;y+=.1;roll=0;land=0;sfx('jump')}else buf=T}
function rollF(){roll=.6;if(y>0)vy=-950;dust(10,1);sfx('roll')}
function mv(d){const n=lane+d;
 if(n<-1||n>1||obs.some(o=>o.l==n&&o.z<45&&o.z+o.len>-35&&(((o.k=='sign'||o.k=='stack')&&y<125)||(o.k=='train'&&y<topAt(o)-30)))){shake=.12;nudge=d*.22;return}
 lane=n;sfx('lane')}
function upd(dt){
 ko=ko.map(v=>M.max(0,v-dt));roomTick(dt);if(st=='spec'){specUpd(dt);return}if(st=='pause'||st=='set'||st=='rank'||st=='name')return;if(st=='count'){cdT-=dt;const nn=M.ceil(cdT);if(nn!=cdLast&&nn>0){cdLast=nn;sfx('tick')}if(cdT<=0){st='play';sfx('start')}return}
 if(st=='load'){dist+=420*dt;G+=dt;if(T>3.4){st='menu';let dd='';try{dd=localStorage.getItem('trilho_day')}catch(e){}if(user&&dd!=new Date().toDateString())dayNeed=1;if(!user||dayNeed)goName('menu')}return}if(st=='menu'||st=='skin'||st=='maps'||st=='infl'||st=='coinc'||st=='train'||ROOMUI(st)){dist+=380*dt;G+=dt;return}
 const over=st=='over';
 if(over){vel*=E(-6*dt);if(pushO&&pushO.z<38)pushO.z+=(38-pushO.z)*(1-E(-12*dt))}else{speed=trn?760:M.min(1100,speed+dt*3.5);vel=speed;G+=dt;pT+=dt;if(!tFz){runT+=dt;liveT+=dt;if(liveT>=3&&st=='play'&&!trn&&!RM){liveT=0;pushLive(M.round(runT*100)/100)}}}
 dist+=vel*dt;
 obs.forEach(o=>o.z-=vel*(1-o.f)*dt);cs.forEach(c=>c.z-=vel*dt);
 obs=obs.filter(o=>o.z+o.len>-205);warn=!over&&obs.some(o=>o.f<0&&o.z>0&&o.z<2000);cs=cs.filter(c=>c.z>-95&&!c.got);for(const a of obs)for(const b of obs)if(a!==b&&a.l==b.l&&a.z<b.z&&a.z+a.len+50>b.z)b.z=a.z+a.len+50;//cs=cs.filter(c=>c.z>-120&&!c.got);
 shake=M.max(0,shake-dt);land=M.max(0,land-dt);tPop=M.max(0,tPop-dt);dizzy=M.max(0,dizzy-dt);for(const p of pt){p.x+=p.vx*dt;p.y+=p.vy*dt;p.l-=dt*(p.t?2.2:1.3)}pt=pt.filter(p=>p.l>0);if(pt.length>70)pt.splice(0,pt.length-70);ab+=((stand?0:1)-ab)*(1-E(-22*dt));cPop=M.max(0,cPop-dt);if(roll>0&&st=='play'&&((G*30)|0)%2==0)dust(1,1);nudge*=E(-12*dt);
 camX+=(px*.6-camX)*(1-E(-9*dt));camY+=(y*.28-camY)*(1-E(-7*dt));
 const yP=y;if(y>0||vy>0){vy-=1900*dt;y+=vy*dt}
 let gh=0;sup=null;
 for(const o of obs){const T0=topAt(o);if(!T0)continue;if(M.abs(px-o.l)>(HW[o.k]||.4)+.08||o.z>20||o.z+o.len<-20)continue;if(yP>=T0-(o.ramp?70:o.k=='train'?26:4)&&T0>gh){gh=T0;sup=o}}
 if(y<=gh&&vy<=0){const air=yP>gh+.5;y=gh;vy=0;if(air&&!over){land=.18;dust(6,0);sfx('land')}}
 stand=y<=gh+.5&&vy<=0;if(stand)lastSt=T;
 if(roll>0)roll-=dt;
 rp+=((roll>0&&!over?1:0)-rp)*(1-E(-22*dt));if(rp>.3)rA+=dt*24;
 if(over)return;
 px+=(lane-px)*(1-E(-30*dt));if(M.abs(lane-px)<.003)px=lane;
 if(buf&&T-buf<.14&&stand){buf=0;jump()}
 if(trn){trT-=dt;if(trT<=0){trSpawn();trT=trn==1?4:2}}else if(dist>=nextSp)spawn();for(const o of obs){if(o.s)continue;if(o.k=='train'&&o.z<650){o.s=1;if(T-sT>1.5){sT=T;sfx('train')}}else if(o.k=='car'&&o.z<900){o.s=1;if(T-hT>2.5&&R()<.7){hT=T;sfx('horn')}}}
 const ph=roll>0?34:88;
 for(const o of obs){const hw=HW[o.k]||.4,dx=M.abs(px-o.l);if(dx>hw+.17||o.z>16||o.z+o.len<-16)continue;
  let hit=0;const tp=topAt(o);if(sup===o)continue;
  if(o.ramp){if(tp>=140&&y<tp-24)hit=1}
  else if(o.k=='train'){if(y<tp-36)hit=1}else if(BK[o.k]){if(y<130)hit=1}
  else if(o.k=='high'){if(y<76&&y+ph>58)hit=1}
  else if(tp&&y<tp)hit=tp-y<=16?2:1;
  if(!hit)continue;if(hit==1&&dx<hw+.05){pushO=o;crash(o.k);break}if(o.g)continue;o.g=1;if(dizzy>0){pushO=o;crash(o.k);break}dizzy=6;shake=.2;speed*=.9;sfx('bonk');nudge=(px>o.l?1:-1)*.2;if(dx<hw+.05&&tp&&o.k!='high'&&(PHO[o.k]||o.k=='car'||o.ramp)&&y<tp){y=tp;vy=0}}
 const cy0=y+4,cy1=y+(roll>0?38:92)-4;for(const c of cs)if(!c.got&&c.z<16&&c.z+vel*dt>-16&&((c.l-(px+nudge))*100)**2+(c.y-M.max(cy0,M.min(cy1,c.y)))**2<1024){c.got=1;coins++;cPop=.4;gold();sfx('coin');if(!tFz){tFz=1;tPop=.5;ncM=M.floor(dist/40);if(RM){RM.myC=coins;rmPush()}else if(!trn)pushLive(M.round(runT*100)/100)}}
}

