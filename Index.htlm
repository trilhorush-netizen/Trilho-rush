 g.beginPath();g.moveTo(-r*.7,-r*.8);g.lineTo(r*.7,-r*.8);g.quadraticCurveTo(r*.7,r*.2,0,r*.35);g.quadraticCurveTo(-r*.7,r*.2,-r*.7,-r*.8);g.fill();g.stroke();
