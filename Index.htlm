function setScr(z){g.fillStyle='rgba(10,5,40,.8)';g.fillRect(-OX,0,FW,H);gear(cx-104*z,H*.07-9*z,13*z);tx('Configura\u00e7\u00f5es',cx+10*z,H*.07,28*z,'#fff');
 const top=H*.11,bot=H-82*z,sp=56*z,n0=bt.length,on='#2fb36b',off='#8a3f4f',QL=['BAIXA','M\u00c9DIA','ALTA','ULTRA'],QC=['#7a7f8f','#3f7de0','#2fb36b','#a855f7'];
 setMax=M.max(0,10*sp+44*z-(bot-top));setY=M.max(0,M.min(setMax,setY));const y0=top+6*z-setY;
 g.save();g.beginPath();g.rect(-OX,top,FW,bot-top);g.clip();
