{n:'Bar\u00e3o',t:4,sk:'#e8b184',hr:'#3b2a20',pt:0,pom:0,top:1,o:[['Cl\u00e1ssico','#23232d','#d23a4a','#2c2c38','#23232d','#d23a4a'],['Marfim','#e8e2d0','#3a5fa0','#6a5a4a','#e8e2d0','#3a5fa0'],['Real','#5a2f8a','#ffd23f','#2a1a3a','#5a2f8a','#ffd23f']]},
{n:'Astro',t:5,sk:'#c68a5a',hr:'#2a2a3a',pt:0,pom:0,ant:1,o:[['Branco','#eceff6','#ff7a3d','#c8cedc','#eceff6','#ff7a3d'],['Laranja','#ff8a2e','#2a3a6a','#c8cedc','#ffd9b0','#2a3a6a'],['Verde','#5fd28a','#ffffff','#2f4a3a','#c8ffe0','#ffffff']]},
