applySat();fetchRank();
function rkSave(){try{localStorage.setItem('trilho_rank',JSON.stringify(rk))}catch(e){}}
function fmt(t){const p=n=>(n<10?'0':'')+n;return p(M.floor(t/60))+':'+p(M.floor(t%60))+'.'+p(M.floor((t*100)%100))}
function submit(){rkMsg='';rkOk=0;rkUndo=null;
 if(respUsed){rkMsg='Renascer/menus usados: partida fora do ranking';return}
  if(!user)return;
 const t=M.round(runT*100)/100,i=rk.findIndex(e=>e.n.toLowerCase()==user.toLowerCase()),prev=i>=0?{n:rk[i].n,t:rk[i].t}:null;
 rkOk=1;pushGlobal(t);
 if(prev&&prev.t>=t){rkMsg='Tempo '+fmt(t)+' (seu melhor no Top: '+fmt(prev.t)+')';return}
 if(i>=0)rk[i]={n:user,t};else rk.push({n:user,t});
 rk.sort((a,b)=>b.t-a.t);rk=rk.slice(0,20);rkSave();rkUndo={n:user,prev};rkMsg='Tempo '+fmt(t)+(RANK_URL?' enviado ao Top Global!':' guardado (Top Global n\u00e3o configurado)')}
function undoRank(){undoGlobal();if(!rkUndo)return;const i=rk.findIndex(e=>e.n.toLowerCase()==rkUndo.n.toLowerCase());if(i>=0)rk.splice(i,1);if(rkUndo.prev)rk.push(rkUndo.prev);rk.sort((a,b)=>b.t-a.t);rkSave();rkUndo=null}
function goName(nx){nameNext=nx;nameErr='';st='name';if(unEl){unEl.value=user;unEl.style.display='block';pwEl.value=(user&&savedH)?'••••••••':'';pwEl.style.display='block';try{(user?pwEl:unEl).focus()}catch(e){}}}
function hideName(){for(const e of[unEl,pwEl])if(e){e.style.display='none';try{e.blur()}catch(x){}}}
async function confirmName(){const v=((unEl&&unEl.value)||'').trim(),pv=pwEl.value;
 if(!/^[A-Za-z0-9_.\-\u00c0-\u00ff]{3,14}$/.test(v)){nameErr='Use de 3 a 14 caracteres: letras, números, _ . -';return}
 if(pv.length<4){nameErr='Senha: mínimo de 4 caracteres';return}
 nameErr='Verificando...';
 try{const lc=v.toLowerCase(),h=(pv=='••••••••'&&savedH&&lc==user.toLowerCase())?savedH:await sha(lc+':'+pv),p='/users/'+encodeURIComponent(lc)+'.json',u=await rj(p);
  if(u&&u.h!==h){nameErr='Senha incorreta (ou nome já usado)';return}
  if(!u)await rj(p,{method:'PUT',body:JSON.stringify({h,ts:Date.now()})});
  user=v;myId='u_'+lc;savedH=savePw?h:'';
  try{localStorage.setItem('trilho_user',user);localStorage.setItem('trilho_id',myId);localStorage.setItem('trilho_su',savePw?'1':'0');localStorage.setItem('trilho_sh',savePw?h:'');localStorage.setItem('trilho_day',new Date().toDateString())}catch(e){}
 }catch(e){try{const lc=v.toLowerCase(),h=(pv=='••••••••'&&savedH&&lc==user.toLowerCase())?savedH:await sha(lc+':'+pv),k='trilho_lh_'+lc,o=localStorage.getItem(k);if(o&&o!==h){nameErr='Senha incorreta';return}localStorage.setItem(k,h);user=v;myId='u_'+lc;savedH=savePw?h:'';localStorage.setItem('trilho_user',user);localStorage.setItem('trilho_id',myId);localStorage.setItem('trilho_su',savePw?'1':'0');localStorage.setItem('trilho_sh',savePw?h:'');localStorage.setItem('trilho_day',new Date().toDateString())}catch(e2){nameErr='Não foi possível entrar';return}}
 nameErr='';dayNeed=0;hideName();fetchRank();if(nameNext=='start')start();else st=nameNext=='set'?'set':'menu'}
function cancelName(){if(!user||dayNeed)return;hideName();st=nameNext=='set'?'set':'menu'}
