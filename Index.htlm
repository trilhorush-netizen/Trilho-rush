function slHead(K,k,x,y){const t=K.t;g.save();g.translate(x*k,y*k);g.rotate(-M.PI/2+.3);
 if(t==2){rr(-14*k,-14*k,28*k,28*k,9*k,LG(-14*k,0,14*k,0,K.t1,K.t0),1);rr(-6*k,-10*k,20*k,18*k,6*k,'#1b2236',1);g.fillStyle=K.hb3;g.beginPath();g.arc(5*k,-3*k,3.5*k,0,7);g.fill();g.strokeStyle=K.a0;g.lineWidth=2*k;g.beginPath();g.moveTo(0,-14*k);g.lineTo(0,-24*k);g.stroke();g.fillStyle=K.hb3;g.beginPath();g.arc(0,-26*k,3.5*k,0,7);g.fill();g.restore();return}
 if(t==3){g.fillStyle=K.jk;g.beginPath();g.arc(-3*k,0,18*k,0,7);g.fill();g.lineWidth=2*k;g.strokeStyle=OL;g.stroke()}
 if(t==5){g.fillStyle=K.a2;g.beginPath();g.arc(0,0,21*k,0,7);g.fill();g.lineWidth=2*k;g.strokeStyle=OL;g.stroke();g.fillStyle='#223a6a';g.beginPath();g.arc(0,0,16.5*k,0,7);g.fill()}
 g.fillStyle=K.sk;g.beginPath();g.arc(t==3?3*k:0,0,t==5?13*k:15*k,0,7);g.fill();g.lineWidth=2*k;g.strokeStyle=OL;g.stroke();
 if(t==0){g.fillStyle=K.hb0;g.beginPath();g.arc(0,0,16.5*k,M.PI*1.02,M.PI*2.02);g.fill();g.stroke();rr(2*k,-14*k,20*k,8*k,4*k,K.hb2,1);g.fillStyle='#fff';g.beginPath();g.arc(0,-20*k,5*k,0,7);g.fill();g.stroke()}
 if(t==1){g.fillStyle=K.hr0;g.beginPath();g.arc(-2*k,0,17*k,M.PI*.6,M.PI*2.0);g.fill();g.stroke();rr(-30*k,-4*k,18*k,8*k,4*k,K.pt,1)}
 if(t==3){rr(-2*k,-17*k,22*k,6*k,3*k,K.p0,1)}
 if(t==4){g.fillStyle='#17171f';g.beginPath();g.ellipse(0,-13*k,5*k,21*k,0,0,7);g.fill();rr(-8*k,-12*k,26*k,24*k,3*k,'#1c1c24',1);rr(-8*k,-8*k,6*k,16*k,2*k,K.p0)}
 if(t!=2){g.fillStyle='#fff';g.beginPath();g.ellipse(7*k,-3*k,3.2*k,4*k,0,0,7);g.fill();g.fillStyle='#2a1b14';g.beginPath();g.arc(8*k,-3*k,2*k,0,7);g.fill();if(t!=3){g.strokeStyle='#5a2a20';g.lineWidth=1.6*k;g.beginPath();g.arc(9*k,7*k,4*k,-.4,1.4);g.stroke()}}
 g.restore()}
