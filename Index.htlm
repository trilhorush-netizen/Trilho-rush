function pyr(bx,yt,w,yb){const m=bx+w/2,ap=yt-w*.1;P([[bx-w*.1,yb],[m,ap],[m,yb]],'#ecc886');P([[m,ap],[bx+w*1.1,yb],[m,yb]],'#b98a47');g.strokeStyle='rgba(90,55,20,.35)';g.lineWidth=1;g.beginPath();for(let i=1;i<9;i++){const t=i/9,y=ap+(yb-ap)*t,hw=w*.6*t;g.moveTo(m-hw,y);g.lineTo(m+hw,y)}g.stroke();g.fillStyle='#3a2410';g.fillRect(m-w*.06,yb-w*.15,w*.12,w*.15);P([[m-w*.05,ap+w*.12],[m,ap],[m+w*.05,ap+w*.12]],'#ffd23f')}
function dancer(x,y0,u,id){const sw=M.sin(T*4+id),c=['#efe6cc','#2fb3a0','#e86a8a','#f2c14a'][id%4],gd='#ffd23f',sx=sw*3*u;g.lineCap='round';g.fillStyle='rgba(0,0,0,.2)';g.beginPath();g.ellipse(x,y0,20*u,5*u,0,0,7);g.fill();
 P([[x-9*u+sx,y0-62*u],[x+9*u+sx,y0-62*u],[x+16*u-sw*4*u,y0],[x-16*u-sw*4*u,y0]],c);g.strokeStyle='rgba(0,0,0,.25)';g.lineWidth=1.2*u;for(let i=-2;i<=2;i++){g.beginPath();g.moveTo(x+i*3*u+sx,y0-60*u);g.lineTo(x+i*6*u-sw*4*u,y0);g.stroke()}g.fillStyle=gd;g.fillRect(x-9*u+sx,y0-62*u,18*u,5*u);
 const sy=y0-58*u,a1=sy+6*u+sw*4*u,a2=sy+6*u-sw*4*u;g.strokeStyle='#b57a4a';g.lineWidth=4*u;g.beginPath();g.moveTo(x+sx-8*u,sy);g.lineTo(x+sx-20*u,a1);g.lineTo(x+sx-14*u,sy-14*u-sw*5*u);g.stroke();g.beginPath();g.moveTo(x+sx+8*u,sy);g.lineTo(x+sx+20*u,a2);g.lineTo(x+sx+14*u,sy-14*u+sw*5*u);g.stroke();
 g.strokeStyle=gd;g.lineWidth=2*u;g.beginPath();g.arc(x+sx-20*u,a1,2.5*u,0,7);g.stroke();g.beginPath();g.arc(x+sx+20*u,a2,2.5*u,0,7);g.stroke();
 const hx=x+sw*4*u,hy=y0-72*u;g.fillStyle='#b57a4a';g.beginPath();g.arc(hx,hy,7*u,0,7);g.fill();g.fillStyle='#1c1410';g.beginPath();g.arc(hx,hy-u,7.6*u,M.PI,0);g.fill();g.fillRect(hx-7.6*u,hy-u,3*u,16*u);g.fillRect(hx+4.6*u,hy-u,3*u,16*u);P([[hx-8*u,hy-4*u],[hx,hy-16*u],[hx+8*u,hy-4*u]],gd);g.fillStyle='#e04a5a';g.beginPath();g.arc(hx,hy-8*u,2*u,0,7);g.fill();g.fillStyle='#fff';g.fillRect(hx-4*u,hy-u,2.4*u,1.8*u);g.fillRect(hx+1.6*u,hy-u,2.4*u,1.8*u)}
function warnHud(z){if(st!='play'||!warn)return;const o=obs.filter(q=>q.f<0&&q.z>0&&q.z<2000).sort((a,b)=>a.z-b.z)[0];if(!o)return;const p=M.sin(T*14),k=1+.12*p,nr=M.max(0,1-o.z/2000),x=gX(o.l,0)+M.sin(T*40)*nr*3,y=H*.2-M.abs(M.sin(T*7))*8*z;
g.fillStyle='rgba(255,40,40,'+(.05+.1*(p>0?1:.3)*(nr+.3))+')';g.fillRect(-OX,0,FW,H);g.save();g.translate(x,y);g.scale(k,k);const gl=g.createRadialGradient(0,0,4*z,0,0,56*z);gl.addColorStop(0,'rgba(255,60,40,.75)');gl.addColorStop(1,'rgba(255,60,40,0)');g.fillStyle=gl;g.beginPath();g.arc(0,0,56*z,0,7);g.fill();g.lineJoin='round';P([[0,-34*z],[34*z,24*z],[-34*z,24*z]],'#ffcf1f');g.lineWidth=4*z;g.strokeStyle=OL;g.stroke();g.strokeStyle='#c4151c';g.lineWidth=5*z;g.lineCap='round';g.beginPath();g.moveTo(0,-18*z);g.lineTo(0,6*z);g.stroke();g.fillStyle='#c4151c';g.beginPath();g.arc(0,15*z,3.4*z,0,7);g.fill();g.restore();
for(let i=0;i<3;i++){const a=(T*3+i/3)%1;g.globalAlpha=1-a;P([[x-14*z,y+44*z+a*40*z],[x,y+56*z+a*40*z],[x+14*z,y+44*z+a*40*z]],'#ff4040')}g.globalAlpha=1}
