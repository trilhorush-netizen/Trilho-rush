<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Trilho Rush</title>
<style>
:root{--bg:#d9d3ee;--fg:#1b1533;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e0a1f;--fg:#fff}}
:root[data-theme="dark"]{--bg:#0e0a1f;--fg:#fff}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--fg);user-select:none;-webkit-user-select:none}
#w{height:100%;display:flex;justify-content:center;align-items:center}
canvas{display:block;touch-action:none}
#un,#pw,#rn,#rc{position:fixed;left:50%;top:46%;transform:translate(-50%,-50%);width:calc(264px*var(--z,1));max-width:90vw;box-sizing:border-box;padding:calc(13px*var(--z,1)) calc(14px*var(--z,1));font:800 calc(22px*var(--z,1)) Trebuchet MS,system-ui,sans-serif;border-radius:16px;border:3px solid #ffd23f;background:#fffdf4;color:#241b5c;text-align:center;display:none;z-index:5;outline:none;box-shadow:0 6px 0 rgba(0,0,0,.35),0 0 26px rgba(255,210,63,.5)}
#pw{top:calc(46% + 62px*var(--z,1))}
#rn,#rc{font-size:calc(18px*var(--z,1));padding:calc(10px*var(--z,1)) calc(12px*var(--z,1))}#rc{text-transform:uppercase;letter-spacing:.12em}
</style>
</head>
<body>
<div id="w"><canvas id="c"></canvas></div>
<input id="un" maxlength="14" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Seu username">
<input id="pw" type="password" maxlength="30" autocomplete="off" placeholder="Senha">
<input id="rn" maxlength="18" autocomplete="off" spellcheck="false" placeholder="Nome">
<input id="rc" maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="C\u00d3DIGO">
<input id="ph" type="file" accept="image/*" style="display:none">
<script>
const cv=document.getElementById('c'),g=cv.getContext('2d'),R=Math.random,M=Math,OL='#1b1233',E=M.exp;
let SPC=0,TM=0,warn=0,liveT=0,livePend=0,liveBusy=0,gBest=-1,W,H,U,LW,cx,hy,gy,FW=0,OX=0,UW=0,UOX=0,SKY,VIG,HAZE,LIGHT,camX=0,camY=0,RS=1,goodN=0,OVc=null,SK=null,wI=0,wO=0,mapMsg=0,pT=0,S={mus:1,mov:1,fps:0,ctl:0,q:2,ch:0,oo:[0,0,0,0,0,0],sat:100,map:0};
function fit(){SPC=S.map==1?1:0;TM=S.map|0;const w=document.getElementById('w'),d=M.max(.75,M.min(devicePixelRatio||1,[1,1.25,1.6,2][S.q])*RS);H=w.clientHeight;FW=w.clientWidth;W=M.min(FW,M.round(H*.95));OX=(FW-W)/2;UW=M.min(W,M.round(H*.66));UOX=(FW-UW)/2;cv.width=FW*d;cv.height=H*d;cv.style.width=FW+'px';cv.style.height=H+'px';g.setTransform(d,0,0,d,OX*d,0);document.documentElement.style.setProperty('--z',UW/380);LW=W*.31;U=LW/100;cx=W/2;hy=H*.3;gy=H*.88;
 SKY=g.createLinearGradient(0,0,0,hy+4);SKY.addColorStop(0,SPC?'#05040f':KK('#3d8fe0'));SKY.addColorStop(.6,SPC?'#1a1240':KK('#7fd6f0'));SKY.addColorStop(1,SPC?'#4a2a7a':KK('#ffe9b8'));
 VIG=g.createRadialGradient(cx,H*.55,W*.35,cx,H*.55,H*.72);VIG.addColorStop(0,'rgba(20,10,60,0)');VIG.addColorStop(1,'rgba(20,10,60,.4)');
 HAZE=g.createLinearGradient(0,hy,0,hy+H*.25);HAZE.addColorStop(0,SPC?'rgba(70,40,130,.55)':'rgba(215,240,250,.5)');HAZE.addColorStop(1,SPC?'rgba(70,40,130,0)':'rgba(215,240,250,0)');
 LIGHT=g.createLinearGradient(0,0,W,H);LIGHT.addColorStop(0,'rgba(255,238,190,.12)');LIGHT.addColorStop(1,'rgba(40,20,90,.1)');try{OVc=document.createElement('canvas');OVc.width=FW*d|0;OVc.height=H*d|0;const o2=OVc.getContext('2d');o2.setTransform(d,0,0,d,OX*d,0);o2.fillStyle=LIGHT;o2.fillRect(-OX,0,FW,H);o2.fillStyle=VIG;o2.fillRect(-OX,0,FW,H)}catch(e){OVc=null}}
addEventListener('resize',fit);fit();
const D=290,sc=z=>1/(1+z/D),gY=z=>hy+(gy-hy+camY*U)*sc(z),gX=(x,z)=>cx+(x-camX)*LW*sc(z);
function P(p,c){g.fillStyle=c;g.beginPath();p.forEach((q,i)=>i?g.lineTo(q[0],q[1]):g.moveTo(q[0],q[1]));g.closePath();g.fill()}
function rr(x,y,w,h,r,c,o){g.beginPath();g.roundRect?g.roundRect(x,y,w,h,r):g.rect(x,y,w,h);g.fillStyle=c;g.fill();if(o){g.lineWidth=2*U;g.strokeStyle=OL;g.stroke()}}
function ln(a,b,c,d,w,col){g.lineCap='round';g.strokeStyle=OL;g.lineWidth=w+3*U;g.beginPath();g.moveTo(a,b);g.lineTo(c,d);g.stroke();g.strokeStyle=col;g.lineWidth=w;g.stroke()}
function sq(x,za,zb,h0,h1,c){const a=sc(za),b=sc(zb),xa=gX(x,za),xb=gX(x,zb),ya=gY(za),yb=gY(zb);P([[xa,ya-h1*U*a],[xb,yb-h1*U*b],[xb,yb-h0*U*b],[xa,ya-h0*U*a]],c)}

let st='load',dist=0,G=0,T=0,ovT=0,speed=720,vel=720,coins=0,lane=0,px=0,y=0,vy=0,roll=0,rp=0,rA=0,land=0,nudge=0,shake=0,obs=[],cs=[],nextSp=0,pf=0,best=0,buf=0,cdir=1,bt=[],dizzy=0,runT=0,tFz=0,tPop=0,ncM=0,mvNext=0,pt=[],cPop=0,ab=0,pushO=null,cdT=0,cdLast=0,setBack='menu',user='',rk=[],respUsed=0,rkUndo=null,rkMsg='',rkOk=0,nameErr='',nameNext='start',rankBack='menu',sup=null,stand=1,cmC=0,gRk=[],gOK=0,DB=null,UID=null,gWrote=null,gMsg='';
try{best=+localStorage.getItem('trilho_nc')||0}catch(e){}
let cmD=0,lastSt=0,trn=0,trT=0,sPend=null,setY=0,setMax=0,ko=[0,0,0,0],RM=null,rmT=0,rmSend=0,rmFetch=0,rmBusy=0,mapBack=-1,spw=null,spId='',spBack='lobby',spF=0,spNew=0,spFirst=0,old2=0,lastSK=null,rankAdm=0,admMsg='',admMsgT=0,joinMsg='',rcf={n:'',c:'',mx:6,mp:0,hp:1};
function reset(){cmD=-9999;dist=0;speed=vel=640;coins=0;lane=0;px=0;y=0;vy=0;roll=0;rp=0;land=0;nudge=0;shake=0;obs=[];cs=[];nextSp=500;pf=0;buf=0;dizzy=0;runT=0;tFz=0;tPop=0;ncM=0;mvNext=0;pt=[];cPop=0;ab=0;pushO=null;respUsed=0;rkUndo=null;rkMsg='';rkOk=0;sup=null;stand=1;pT=0;gWrote=null;liveT=0;livePend=0;trT=1.2;ko=[0,0,0,0]}
reset();
const TC=[['#d63b3b','#9f2528','#ef6a63','#ffd23f'],['#2f8f9d','#1f6470','#52b8c6','#ffffff'],['#e0a526','#a67613','#f4c75a','#3a2d63'],['#5b6ee0','#3e4aa6','#8493f2','#ffd23f']];

const PHO={animal:100,low:42,crate:44,bin:56,cone:34,high:76,cart:46,van:72},RL=130,HW={animal:.38,train:.4,car:.4,crate:.36,stack:.36,bin:.21,low:.43,high:.4,sign:.36,cone:.38,cart:.34,van:.4},BK={train:1,sign:1,stack:1},LN={low:30,crate:50,bin:36,cone:30,car:150,stack:60,cart:40,van:220},PFT=['','','','low','high','crate','bin','cone','car','cart'],OT=['','','low','high','crate','crate','bin','bin','cone','cone','car','car','stack','sign','cart','cart','van'];
const TS=[['#6d7cff','#4a55c4','#99a5ff','#7df9ff'],['#b06bff','#7a3fc4','#d2a0ff','#ff6bd6'],['#3fd0c0','#2a8fa8','#7af0e0','#ffd23f'],['#e8ecff','#9aa1c8','#ffffff','#6d7cff']],SPP=['#5b5f8f','#6a4f9a','#3f5f9a','#4a4f70','#7a5aa8','#2f6f8f'];
function blk(o,h,w,c,det,sdet,b0){b0=b0||0;
const l=o.l,zf=M.max(o.z,-210),zb=o.z+o.len,yf=gY(zf),hf=h*U*sc(zf),xl=gX(l-w,zf),xr=gX(l+w,zf),bl=gX(l-w,zb),br=gX(l+w,zb),yb=gY(zb),hb=h*U*sc(zb),bf=b0*U*sc(zf),bb=b0*U*sc(zb);
if(!b0)P([[gX(l-w-.12,zf),yf],[gX(l+w+.12,zf),yf],[gX(l+w+.12,zb),yb],[gX(l-w-.12,zb),yb]],'rgba(0,0,0,.25)');
const dx=l-camX,sx=dx<-.1?l+w:dx>.1?l-w:0;
if(sx){P([[gX(sx,zf),yf-hf],[gX(sx,zf),yf-bf],[gX(sx,zb),yb-bb],[gX(sx,zb),yb-hb]],c[1]);if(sdet)sdet(sx,zf,zb)}
P([[xl,yf-hf],[xr,yf-hf],[br,yb-hb],[bl,yb-hb]],c[2]);
if(o.z>=-210){g.fillStyle=c[0];g.fillRect(xl,yf-hf,xr-xl,hf-bf);if(det)det(xl,xr,yf-hf,yf-bf);
g.strokeStyle=OL;g.lineWidth=1.5;g.strokeRect(xl,yf-hf,xr-xl,hf-bf)}}
function crate(o,n){const H2=n*44;
blk(o,H2,.36,(SPC?['#8d96ad','#5f6880','#b7c0d6']:TM>1?CRC[TM]:['#b9854a','#8c6236','#d9a868']),(a,b,t,bt)=>{const lh=(bt-t)/n,w=b-a;
for(let j=0;j<n;j++){const t0=t+j*lh;g.fillStyle='rgba(60,35,15,.16)';for(let i=1;i<6;i++)g.fillRect(a,t0+lh*i/6,w,M.max(1,lh*.015));
g.strokeStyle=(SPC?'#3c4258':KK('#6b4a26'));g.lineWidth=M.max(1,w*.05);g.strokeRect(a+w*.06,t0+lh*.06,w*.88,lh*.88);
g.beginPath();g.moveTo(a+w*.06,t0+lh*.06);g.lineTo(b-w*.06,t0+lh*.94);g.moveTo(b-w*.06,t0+lh*.06);g.lineTo(a+w*.06,t0+lh*.94);g.stroke();
g.fillStyle='#c9ced6';for(const q of[[.08,.08],[.92,.08],[.08,.92],[.92,.92]]){g.beginPath();g.arc(a+w*q[0],t0+lh*q[1],M.max(1,w*.025),0,7);g.fill()}
if(j==0){g.fillStyle='rgba(30,20,10,.55)';g.fillRect(a+w*.3,t0+lh*.44,w*.4,lh*.06);g.fillRect(a+w*.36,t0+lh*.54,w*.28,lh*.05)}}},
(sx,zf,zb)=>{for(let j=1;j<n*3;j++)sq(sx,zf,zb,H2*j/(n*3)-.8,H2*j/(n*3)+.8,'rgba(0,0,0,.28)');for(let z=zf+10;z<zb;z+=18)sq(sx,z,z+1.5,0,H2,'rgba(0,0,0,.18)')})}
function crateOld(o,n){blk(o,n*44,.36,['#b9854a','#8c6236','#d9a868'],(a,b,t,bt)=>{const lh=(bt-t)/n,w=b-a;for(let j=0;j<n;j++){const t0=t+j*lh;g.strokeStyle='#6b4a26';g.lineWidth=M.max(1,w*.05);g.strokeRect(a+w*.06,t0+lh*.06,w*.88,lh*.88);g.beginPath();g.moveTo(a+w*.06,t0+lh*.06);g.lineTo(b-w*.06,t0+lh*.94);g.moveTo(b-w*.06,t0+lh*.06);g.lineTo(a+w*.06,t0+lh*.94);g.stroke();g.fillStyle='rgba(0,0,0,.12)';g.fillRect(a,t0+lh*.5,w,lh*.04)}})}
function bin(o){if(TM>1)return binT(o);
const z=o.z,s=sc(z),x=gX(o.l,z),y0=gY(z),r=.2*LW*s,h=56*U*s;
g.fillStyle='rgba(0,0,0,.28)';g.beginPath();g.ellipse(x,y0,r*1.3,r*.4,0,0,7);g.fill();
g.fillStyle=(SPC?'#7a3a14':KK('#1d5a3d'));g.beginPath();g.ellipse(x,y0,r*.82,r*.22,0,0,7);g.fill();
P([[x-r,y0-h],[x+r,y0-h],[x+r*.82,y0],[x-r*.82,y0]],LG(x-r,0,x+r,0,(SPC?'#ff9a3d':KK('#58b883')),(SPC?'#a8501a':KK('#1f5e40'))));
g.fillStyle='rgba(255,255,255,.18)';g.fillRect(x-r*.55,y0-h*.9,r*.12,h*.85);g.fillStyle='rgba(235,250,240,.55)';g.fillRect(x-r*.9,y0-h*.55,r*1.8,h*.1);
g.strokeStyle=OL;g.lineWidth=1.5;g.beginPath();g.moveTo(x-r,y0-h);g.lineTo(x-r*.82,y0);g.moveTo(x+r,y0-h);g.lineTo(x+r*.82,y0);g.stroke();
g.fillStyle=(SPC?'#ffc27a':KK('#74d19b'));g.beginPath();g.ellipse(x,y0-h,r*1.06,r*.3,0,0,7);g.fill();g.stroke();
g.fillStyle=(SPC?'#c46a24':KK('#2c8057'));g.beginPath();g.ellipse(x,y0-h-r*.04,r*.85,r*.2,0,0,7);g.fill();g.fillStyle=(SPC?'#7a3a14':KK('#1d5a3d'));g.fillRect(x-r*.25,y0-h-r*.3,r*.5,r*.14);
g.strokeStyle='rgba(0,0,0,.18)';g.lineWidth=1;for(let i=-2;i<=2;i++){g.beginPath();g.moveTo(x+i*r*.32,y0-h*.95);g.lineTo(x+i*r*.27,y0-h*.04);g.stroke()}g.fillStyle='rgba(40,25,10,.25)';g.fillRect(x-r*.82,y0-h*.22,r*1.64,h*.22);
g.fillStyle='#e9e4d8';g.beginPath();g.arc(x+r*.3,y0-h-r*.28,r*.2,0,7);g.fill();g.fillStyle='#d65a5a';g.beginPath();g.arc(x-r*.25,y0-h-r*.22,r*.16,0,7);g.fill()}
function cones(o){if(TM>1)return coneT(o);
for(const dx of[-.27,0,.27]){const zz=o.z+(dx?12:0),s=sc(zz),x=gX(o.l+dx,zz),y0=gY(zz),h=36*U*s,bw=.11*LW*s,b=4*U*s;
g.fillStyle='rgba(0,0,0,.25)';g.beginPath();g.ellipse(x,y0,bw*1.6,bw*.5,0,0,7);g.fill();
g.fillStyle='#2b2b36';g.fillRect(x-bw*1.3,y0-b,bw*2.6,b);
P([[x-bw,y0-b],[x+bw,y0-b],[x+bw*.2,y0-h],[x-bw*.2,y0-h]],LG(x-bw,0,x+bw,0,SPC?'#35e0ff':KK('#ff8a2a'),SPC?'#1a8fb0':KK('#d8530c')));
P([[x-bw*.62,y0-h*.62],[x+bw*.62,y0-h*.62],[x+bw*.45,y0-h*.42],[x-bw*.45,y0-h*.42]],'#f6f6f6');g.fillStyle='rgba(255,255,255,.3)';g.fillRect(x-bw*.5,y0-h*.9,bw*.25,h*.8);g.fillStyle='#f6f6f6';g.fillRect(x-bw*.3,y0-h*.86,bw*.6,h*.08)}}
function topAt(o){const k=o.k;if(k=='car')return o.h||52;if(k=='train'){if(!o.ramp)return 150;const r=-o.z;return r<=0?0:r>=RL?150:150*r/RL}return PHO[k]||0}
function ramp(o){const l=o.l,w=.4,z0=M.max(o.z,-205),z1=o.z+RL;if(z1<=z0)return;
 const Yp=(z,h)=>gY(z)-h*U*sc(z),hz=z=>150*(z-o.z)/RL,dx=l-camX,sx=dx<-.1?l+w:dx>.1?l-w:0,h0=hz(z0);
 const quad=(xa,xb,za,zb,ha,hb,c)=>P([[gX(xa,za),Yp(za,ha)],[gX(xb,za),Yp(za,ha)],[gX(xb,zb),Yp(zb,hb)],[gX(xa,zb),Yp(zb,hb)]],c);
 if(sx){P([[gX(sx,z0),Yp(z0,0)],[gX(sx,z1),Yp(z1,0)],[gX(sx,z1),Yp(z1,150)],[gX(sx,z0),Yp(z0,h0)]],'#4f5563');
  g.strokeStyle='rgba(0,0,0,.28)';g.lineWidth=1;g.beginPath();for(let i=1;i<5;i++){const zz=o.z+RL*i/5;if(zz<z0)continue;g.moveTo(gX(sx,zz),Yp(zz,0));g.lineTo(gX(sx,zz),Yp(zz,hz(zz)))}g.stroke();
  g.fillStyle='rgba(255,255,255,.35)';for(let i=1;i<5;i++){const zz=o.z+RL*i/5;if(zz<z0)continue;g.fillRect(gX(sx,zz)-1,Yp(zz,hz(zz)*.5),2,2)}}
 quad(l-w,l+w,z0,z1,h0,150,'#555b6b');
 quad(l-w*.6,l+w*.6,z0,z1,h0,150,'#687086');
 for(let i=0;i<12;i++){const za=o.z+RL*i/12,zb=za+RL/12;if(zb<z0)continue;const za2=M.max(za,z0),ha=hz(za2),hb=hz(zb),c=i%2?'#ffcf2e':'#23232b';quad(l-w*.96,l-w*.74,za2,zb,ha,hb,c);quad(l+w*.74,l+w*.96,za2,zb,ha,hb,c)}
 for(let i=1;i<11;i++){const za=o.z+RL*i/11;if(za<z0)continue;const zb=za+RL*.022;quad(l-w*.56,l+w*.56,za,zb,hz(za),hz(zb),'rgba(18,20,28,.5)')}
 for(let i=0;i<3;i++){const za=o.z+RL*(.2+i*.27);if(za<z0)continue;const zm=za+RL*.13,zb=za+RL*.07;P([[gX(l-w*.26,za),Yp(za,hz(za))],[gX(l,zm),Yp(zm,hz(zm))],[gX(l+w*.26,za),Yp(za,hz(za))],[gX(l,zb),Yp(zb,hz(zb))]],'#ffcf2e')}
 const rh=20;
 for(const sg of[-1,1]){const xo=l+sg*w,xi=l+sg*(w-.075);
  P([[gX(xi,z0),Yp(z0,h0)],[gX(xi,z1),Yp(z1,150)],[gX(xi,z1),Yp(z1,150+rh)],[gX(xi,z0),Yp(z0,h0+rh)]],'#9aa1b3');
  P([[gX(xi,z0),Yp(z0,h0+rh)],[gX(xo,z0),Yp(z0,h0+rh)],[gX(xo,z1),Yp(z1,150+rh)],[gX(xi,z1),Yp(z1,150+rh)]],'#ffd84a');
  if(sx&&sg*(sx-l)>0)P([[gX(xo,z0),Yp(z0,h0)],[gX(xo,z1),Yp(z1,150)],[gX(xo,z1),Yp(z1,150+rh)],[gX(xo,z0),Yp(z0,h0+rh)]],'#c9a21a');
  P([[gX(xi,z0),Yp(z0,h0+rh)],[gX(xo,z0),Yp(z0,h0+rh)],[gX(xo,z0),Yp(z0,h0)],[gX(xi,z0),Yp(z0,h0)]],'#ffefa0')}
 P([[gX(l-w,z0),Yp(z0,h0)],[gX(l+w,z0),Yp(z0,h0)],[gX(l+w,z0),Yp(z0,h0)+5*U*sc(z0)],[gX(l-w,z0),Yp(z0,h0)+5*U*sc(z0)]],'#ffcf2e')}
function rampOld(o){const l=o.l,w=.4,z0=M.max(o.z,-205),z1=o.z+RL,Yp=(z,h)=>gY(z)-h*U*sc(z),dx=l-camX,sx=dx<-.1?l+w:dx>.1?l-w:0;if(z1<=z0)return;const h0=150*(z0-o.z)/RL;
 if(sx)P([[gX(sx,z0),Yp(z0,0)],[gX(sx,z1),Yp(z1,0)],[gX(sx,z1),Yp(z1,150)],[gX(sx,z0),Yp(z0,h0)]],'#5b606c');
 P([[gX(l-w,z0),Yp(z0,h0)],[gX(l+w,z0),Yp(z0,h0)],[gX(l+w,z1),Yp(z1,150)],[gX(l-w,z1),Yp(z1,150)]],'#8a8f9c');
 for(let i=1;i<6;i++){const za=o.z+RL*i/6,zb=za+RL*.06;if(zb<z0)continue;const ha=150*(za-o.z)/RL,hb=150*(zb-o.z)/RL;P([[gX(l-w,za),Yp(za,ha)],[gX(l+w,za),Yp(za,ha)],[gX(l+w,zb),Yp(zb,hb)],[gX(l-w,zb),Yp(zb,hb)]],i%2?'#ffcf2e':'#2a2a33')}
 P([[gX(l-w,z0),Yp(z0,h0)],[gX(l+w,z0),Yp(z0,h0)],[gX(l+w,z0),Yp(z0,h0)+4*U*sc(z0)],[gX(l-w,z0),Yp(z0,h0)+4*U*sc(z0)]],'#ffcf2e')}
