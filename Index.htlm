 row('Controles',['TUDO','SETAS','WASD','TOQUE'][S.ctl],'#4f6bd8',y0+3*sp,'tctl',z);
 row('Usu\u00e1rio',(user||'-').slice(0,9),'#4f6bd8',y0+4*sp,'tusr',z);
 row('Qualidade',QL[S.q],QC[S.q],y0+5*sp,'tq',z);slider(y0+6*sp,z);
 rowC('Personalizar moeda',y0+7*sp,'coinc',z,(x,y)=>cdraw(x,y,11*z,T*3,0));
 row('Overlay de teclas',S.ko?'LIGADO':'DESLIGADO',S.ko?on:off,y0+8*sp,'tko',z);
 row(trn?'Sair do treino':'Treinar',trn?'SAIR':'ABRIR',trn?'#c24d4d':'#4f6bd8',y0+9*sp,'ttrn',z);
 tp('Baixa: menos detalhes | Ultra: m\u00e1xima qualidade',cx,y0+10*sp+8*z,12*z,'#cfc7ee');
 tp('Atalhos: M m\u00fasica | F FPS | C controles | Q qualidade',cx,y0+10*sp+28*z,11*z,'#9a93c8');
 g.restore();
 for(let i=bt.length-1;i>=n0;i--){const q=bt[i],t0=M.max(q.y,top),t1=M.min(q.y+q.h,bot);if(t1-t0<8*z)bt.splice(i,1);else{q.y=t0;q.h=t1-t0}}
 if(setMax>0){const th=(bot-top)*(bot-top)/(bot-top+setMax),ty=top+(bot-top-th)*setY/setMax;rr(cx+146*z,ty,4*z,th,2*z,'rgba(255,255,255,.35)')}
 btn('Voltar',cx,H-72*z,200*z,50*z,'back','#2fb36b')}
