function badge(x,y,r){g.save();g.translate(x,y);g.fillStyle='#20a4f3';g.beginPath();for(let i=0;i<=48;i++){const a=i/48*M.PI*2,q=r*(1+.1*M.cos(a*8));g.lineTo(M.cos(a)*q,M.sin(a)*q)}g.closePath();g.fill();g.strokeStyle=OL;g.lineWidth=M.max(1,r*.1);g.stroke();g.strokeStyle='#fff';g.lineWidth=r*.24;g.lineCap='round';g.lineJoin='round';g.beginPath();g.moveTo(-r*.4,0);g.lineTo(-r*.1,r*.32);g.lineTo(r*.45,-r*.3);g.stroke();g.restore()}
