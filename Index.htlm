 if(trn==1){const cc=pal[(R()*4)|0];for(const l of[-1,1])obs.push({k:'car',l,z:2600,len:780,f:0,h:90,c:cc,sd:(R()*997)|0});for(let j=0;j<7;j++)cs.push({l:0,z:2650+j*105,y:28,got:0});for(let j=0;j<4;j++){cs.push({l:-1,z:2680+j*190,y:122,got:0});cs.push({l:1,z:2775+j*190,y:122,got:0})}}
 else{for(const l of[-1,0,1])for(let j=0;j<4;j++)cs.push({l,z:2600+j*90,y:28,got:0})}}
