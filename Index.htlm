 g.fillRect(-r*.12,r*.3,r*.24,r*.35);g.fillRect(-r*.45,r*.65,r*.9,r*.22);g.fillStyle='rgba(255,255,255,.55)';g.fillRect(-r*.45,-r*.65,r*.14,r*.7);g.restore()}
