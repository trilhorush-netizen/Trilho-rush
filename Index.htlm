rr(cx-w/2,y0,w,16*z,8*z,'rgba(20,10,50,.65)');rr(cx-w/2+2*z,y0+2*z,M.max(2,(w-4*z)*f),12*z,6*z,f<.3?'#ff6b6b':'#ffb02e');
tx('Tonto! '+dizzy.toFixed(1)+'s',cx,y0+36*z,15*z,'#fff')}
const TIPS=[['Modo NO COIN: corra o máximo','sem pegar nenhuma moeda!','Pular ou rolar também desvia delas.'],['Passou raspando em um obstáculo?','Você fica tonto por 6 segundos.','Raspou de novo? A corrida acaba!'],['Pegue uma moeda para travar','o cronômetro no seu melhor tempo.'],['Deslize para baixo no ar','para cair mais rápido e rolar!'],['Trens em movimento chegam','mais devagar. Fique de olho!']];
let tip=TIPS[(R()*TIPS.length)|0];
function tp(s,x,yy,z,c){g.font='800 '+z+'px Trebuchet MS,system-ui,sans-serif';g.textAlign='center';g.fillStyle=c;g.fillText(s,x,yy)}
function loadScr(){
const z=W/380,p=M.min(1,T/3.4),y0=H*.68;
g.fillStyle=VIG;g.fillRect(-OX,0,FW,H);tx('TRILHO RUSH',cx,H*.1,40*z,'#ffcf2e');
g.fillStyle=LG(0,y0,0,H,'#e9ecf4','#c9cfdd');g.fillRect(0,y0,W,H-y0);
g.fillStyle='#3f6ea0';g.fillRect(0,y0+8*z,W,50*z);g.fillStyle='#2f5a88';g.fillRect(0,y0+54*z,W,4*z);
tx('Aqui vai uma dica!',cx,y0+45*z,30*z,'#fff');
tip.forEach((s,i)=>tp(s,cx,y0+88*z+i*24*z,17*z,'#1c2f5a'));
const bw=250*z,bx=cx-bw/2,by=H-60*z;
rr(bx,by,bw,34*z,12*z,'#7ec3ea',1);rr(bx+3*z,by+3*z,M.max(14*z,(bw-6*z)*p),28*z,10*z,'#2f8fd0');
tp('CARREGANDO... '+M.floor(p*100)+'%',cx,by+24*z,16*z,'#10294f')}
function hud(){
 const z=W/380,m=M.floor(dist/40);bt=[];if(!ROOMUI(st)){plIn(rnEl,0,0);plIn(rcEl,0,0)}
 if(S.q>0){if(OVc)g.drawImage(OVc,-OX,0,FW,H);else{g.fillStyle=LIGHT;g.fillRect(-OX,0,FW,H);g.fillStyle=VIG;g.fillRect(-OX,0,FW,H)}}if(dizzy>0&&st=='play')dizzyHud(z);
 if(st!='menu'&&!((st=='set'&&setBack=='menu')||(st=='rank'&&rankBack=='menu')||st=='name'||st=='skin'||st=='maps'||st=='infl'||st=='coinc'||st=='train'||ROOMUI(st))){
  pill(W-96*z,10*z,86*z,38*z);tp('SEM MOEDAS',W-53*z,23*z,9*z,'#cfc7ee');tx((tFz?ncM:m)+' m',W-20*z,42*z,19*z,tFz?'#ffd23f':'#fff','right');timerHud(z);
  {const k2=1+cPop*.9;g.save();g.translate(W-53*z,69*z);g.scale(k2,k2);g.translate(-(W-53*z),-69*z);pill(W-96*z,54*z,86*z,30*z);tx(coins,W-20*z,75*z,19*z,cPop>0?'#fff3a0':'#ffd54a','right');gcoin(W-80*z,69*z,9*z);g.restore()}
  if(st=='play'&&!RM){bt.push({x:4*z,y:6*z,w:38*z,h:46*z,id:'pause'});pill(8*z,13*z,32*z,32*z);g.fillStyle='rgba(255,255,255,.9)';g.fillRect(17*z,21*z,4.5*z,16*z);g.fillRect(25.5*z,21*z,4.5*z,16*z);gearBtn(44*z,13*z,32*z,z);trophyBtn(80*z,13*z,32*z,z)}
 }
 if(st=='play'||st=='count'||st=='over')koDraw(z);if(trn&&(st=='play'||st=='count'||st=='over')){rr(8*z,88*z,78*z,22*z,9*z,'rgba(20,10,50,.6)');tp('TREINO',47*z,104*z,12*z,'#ffd23f')}if(RM&&(st=='play'||st=='count'||st=='over')){const al=pls().filter(p=>!p.f).length;rr(8*z,88*z,150*z,22*z,9*z,'rgba(20,10,50,.6)');tp('SALA '+RM.code+' | '+al+' correndo',83*z,104*z,11*z,'#7dffb0')}
 const ov=st=='pause'||(st=='over'&&T-ovT>.9);
 if(ROOMUI(st)){roomScr(z);return}if(st=='coinc'){bt=[];coinScr(z);return}if(st=='train'){trainScr(z);return}if(st=='infl'){inflScr(z);return}if(st=='skin'){skinScr(z);return}if(st=='maps'){mapsScr(z);return}if(st=='rank'){rankScr(z);return}if(st=='name'){nameScr(z);return}if(st=='set'){setScr(z);return}if(st=='count'){cdScr(z);return}if(st=='menu'){menuScr(z);return}if(!ov)return;if(RM&&st=='over'){g.fillStyle='rgba(15,8,45,.62)';g.fillRect(-OX,0,FW,H);roomOver(z);return}
 g.fillStyle='rgba(15,8,45,.62)';g.fillRect(-OX,0,FW,H);
 if(st=='menu'){
  tx('TRILHO',cx,H*.24,62*z,'#ffcf2e');tx('RUSH',cx,H*.24+58*z,62*z,'#ff7a3d');tx('MODO NO COIN',cx,H*.24+96*z,24*z,'#ffd23f');tp('Corra sem pegar nenhuma moeda',cx,H*.24+124*z,16*z,'#fff');
  btn('Iniciar',cx,H*.5,200*z,58*z,'play','#2fb36b');
  tx('Recorde sem moedas: '+best+' m',cx,H*.5+96*z,18*z,'#cfc7ee');
  tx('Deslize ← → ↑ ↓  ·  setas ou WASD',cx,H*.8,15*z,'#fff');
 }else if(st=='pause'){
  tx('Pausado',cx,H*.28,44*z,'#fff');
  btn('Continuar',cx,H*.4,220*z,56*z,'resume','#2fb36b');btn('Reiniciar',cx,H*.4+74*z,220*z,56*z,'again','#e0a526');btn('Menu',cx,H*.4+148*z,220*z,56*z,'menu','#5b6ee0');btn('Configurações',cx,H*.4+222*z,220*z,56*z,'set','#6b5bd0');btn('Top Global',cx,H*.4+296*z,220*z,56*z,'trophy','#d9a21e');
 }else{
  tx('Fim da corrida',cx,H*.22,38*z,'#ff6b6b');tp('SEM MOEDAS',cx,H*.22+34*z,14*z,'#cfc7ee');tx((tFz?ncM:m)+' m',cx,H*.22+78*z,46*z,tFz?'#ffd23f':'#7dffb0');
  tp(coins?coins+(coins>1?' moedas coletadas':' moeda coletada'):'Corrida limpa!',cx,H*.22+108*z,19*z,coins?'#ffd54a':'#7dffb0');tp('Total: '+m+' m  |  Recorde: '+best+' m',cx,H*.22+136*z,16*z,'#cfc7ee');tp(rkMsg,cx,H*.22+152*z,12*z,rkOk?'#7dffb0':'#ffb0a0');
  btn('Renascer',cx,H*.44,250*z,58*z,'respawn','#e0a526');btn('Tentar de novo',cx,H*.44+70*z,250*z,52*z,'again','#2fb36b');btn('Menu',cx,H*.44+132*z,250*z,52*z,'menu','#5b6ee0');
 }
}
function ui(f){const W0=W,cx0=cx,O0=OX,U0=U,L0=LW;W=UW;cx=W/2;OX=UOX;LW=W*.31;U=LW/100;g.save();g.translate(UOX-O0,0);try{f()}finally{g.restore();W=W0;cx=cx0;OX=O0;U=U0;LW=L0}}
function draw(){if(st=='load'){gy=H*.58;hy=H*.24}else{gy=H*.88;hy=H*.3}
 g.save();if(shake>0)g.translate((R()-.5)*shake*16,(R()-.5)*shake*16);
 bg();city();if(S.q>0){g.fillStyle=HAZE;g.fillRect(-OX,hy,FW,H*.25)}
 if(vel>900){g.strokeStyle='rgba(255,255,255,.14)';g.lineWidth=2;for(let i=0;i<10;i++){const u=((dist*.004+i*.1)%1),an=(i*2.399)%6.28,r1=60+u*u*H*.5,r2=r1+30+u*60;g.beginPath();g.moveTo(cx+M.cos(an)*r1,hy+M.sin(an)*r1*.9);g.lineTo(cx+M.cos(an)*r2,hy+M.sin(an)*r2*.9);g.stroke()}}
 const so=obs.slice().sort((a,b)=>(a.l!==b.l&&a.z<b.z+b.len&&b.z<a.z+a.len)?M.abs(b.l-camX)-M.abs(a.l-camX):b.z-a.z);
 const cl=cs.filter(c=>c.z>-70).sort((a,b)=>b.z-a.z),cf=cl.filter(c=>c.z>0),cn=cl.filter(c=>c.z<=0);let ci=0;
 const cdn=new Set(),above=(c,o)=>c.l==o.l&&c.z<o.z+o.len&&c.y>=(topAt(o)||(BK[o.k]?130:80))-20;
 const hi=new Set();for(const c of cf)if(obs.some(o=>above(c,o)))hi.add(c);so.filter(o=>o.z>0||o===sup).forEach(o=>{for(const c of cf)if(!cdn.has(c)&&!hi.has(c)&&c.z>o.z){cdn.add(c);coin(c)}dObs(o)});const late=[];for(const c of cf)if(!cdn.has(c)){if(hi.has(c))late.push(c);else coin(c)}
 cn.forEach(c=>{if(c.y<=60)coin(c)});
 ply();
 drawPt();so.filter(o=>o.z<=0&&o!==sup).forEach(dObs);late.forEach(coin);cn.forEach(c=>{if(c.y>60)coin(c)});
 if(SPC&&S.q>0){g.globalCompositeOperation='multiply';g.fillStyle='rgb(168,150,235)';g.fillRect(-OX,0,FW,H);g.globalCompositeOperation='source-over'}
 g.restore();if(st=='load')ui(loadScr);else{warnHud(UW/380);ui(hud)}ui(fpsDraw);
}

function start(){if(!user){goName('start');return}reset();st='play';sfx('start')}
function menu(){reset();st='menu'}
function act(a){
 if(st!='play')return;ko[{l:0,r:1,u:2,d:3}[a]]=.22;
 if(a=='l')mv(-1);else if(a=='r')mv(1);else if(a=='u')jump();else if(a=='d')rollF();
}
function press(id){if(rpress(id))return;if(id=='coinc'){st='coinc';return}if(id.indexOf('cc')==0&&id!='cback'){const q=CCOL[+id.slice(2)];if(q){S.cc=q[1];sv()}return}if(id=='cback'){st='set';return}if(id=='tko'){S.ko=!S.ko;sv();return}if(id=='ttrn'){if(trn){trn=0;st='menu';reset()}else st='train';return}if(id=='tback'){st='set';return}if(id=='tr1'||id=='tr2'){trn=id=='tr1'?1:2;setBack='menu';st='menu';reset();return}if(id=='savepw'){savePw=savePw?0:1;return}if(id=='maps'){st='maps';return}if(id=='infl'){st='infl';return}if(id=='wback'){st='menu';return}if(id=='skin'){wI=S.ch;wO=S.oo[S.ch]||0;st='skin';return}if(id=='sksel'){S.ch=wI;S.oo[wI]=wO;SK=skinOf(wI,wO);sv();return}if(id.indexOf('sko')==0){wO=+id.slice(3);return}if(id.indexOf('skc')==0){wI=+id.slice(3);wO=S.oo[wI]||0;return}if(id.indexOf('map')==0){const n=+id.slice(3);if(n<5){S.map=n;sv();fit()}else mapMsg=T+1.4;return}if(id=='trophy'){if(st=='play'||st=='pause'){respUsed=1;undoGlobal()}rankBack=st=='play'?'count':st;st='rank';rkY=0;fetchRank();return}if(id=='rback'){goBack(rankBack);return}if(id=='ok'){confirmName();return}if(id=='ncancel'){cancelName();return}if(id=='tusr'){goName('set');return}if(id=='respawn'){respawn();return}if(id=='set'){if(st=='play'||st=='pause'){respUsed=1;undoGlobal()}setBack=st=='play'?'count':st;setY=0;st='set';return}if(id=='back'){goBack(setBack);return}if(id=='photo'){if(phEl)phEl.click();return}if(id=='tmus'){S.mus=!S.mus;sv();return}if(id=='tmov'){S.mov=!S.mov;sv();return}if(id=='tfps'){S.fps=!S.fps;sv();return}if(id=='tctl'){S.ctl=(S.ctl+1)%4;sv();return}if(id=='tq'){S.q=(S.q+1)%4;sv();fit();return}if(id=='play'||id=='again')start();else if(id=='resume')st='play';else if(id=='pause')st='pause';else if(id=='menu')menu()}
let sx=null,sy=0,done=0;
cv.addEventListener('pointerdown',e=>{
 const r=cv.getBoundingClientRect(),x=e.clientX-r.left-UOX,yy=e.clientY-r.top;
 aud();sx=e.clientX;sy=e.clientY;lastY=e.clientY;done=0;
 sPend=null;for(const b of bt)if(x>=b.x&&x<=b.x+b.w&&yy>=b.y&&yy<=b.y+b.h){done=1;if(b.id=='sat'){dragSat=b;satFrom(x)}else if(st=='set'&&b.id!='back')sPend=b.id;else press(b.id);return}if(st=='set'){done=1;return}if(st=='menu'){start();done=1}
});
cv.addEventListener('pointermove',e=>{if(dragSat){satFrom(e.clientX-cv.getBoundingClientRect().left-UOX);return}if(st=='rank'&&sx!=null){rkY-=e.clientY-lastY;lastY=e.clientY;return}if(st=='set'&&sx!=null){setY-=e.clientY-lastY;lastY=e.clientY;setY=M.max(0,M.min(setMax,setY));if(M.abs(e.clientY-sy)>8)sPend=null;return}
 if(st!='play'||done||sx==null)return;
 const dx=e.clientX-sx,dy=e.clientY-sy;
 if(M.hypot(dx,dy)>9){done=1;if(M.abs(dx)>M.abs(dy))act(dx>0?'r':'l');else act(dy<0?'u':'d')}
});
addEventListener('pointerup',e=>{if(dragSat){dragSat=null;sv()}if(sPend&&st=='set'){const id=sPend;sPend=null;press(id)}sPend=null;if(st=='play'&&!done&&sx!=null){const dx=e.clientX-sx,dy=e.clientY-sy;if(M.hypot(dx,dy)>6){if(M.abs(dx)>M.abs(dy))act(dx>0?'r':'l');else act(dy<0?'u':'d')}}sx=null});
addEventListener('pointercancel',()=>{sx=null;sPend=null});addEventListener('wheel',e=>{if(st=='set'){setY=M.max(0,M.min(setMax,setY+e.deltaY))}},{passive:true});
addEventListener('keydown',e=>{aud();if(e.target&&(e.target.id=='un'||e.target.id=='pw'||e.target.id=='rn'||e.target.id=='rc')){if(e.key=='Enter'){if(st=='join')rmJoin();else if(st=='rcfg')rmCreate();else confirmName()}return}
 const k=e.key.toLowerCase(),m={arrowleft:'l',a:'l',arrowright:'r',d:'r',arrowup:'u',w:'u',' ':'u',arrowdown:'d',s:'d'};
 if(k=='m'){S.mus=!S.mus;sv();return}if(k=='f'){S.fps=!S.fps;sv();return}if(k=='c'){S.ctl=(S.ctl+1)%4;sv();return}if(k=='q'){S.q=(S.q+1)%4;sv();fit();return}if(st=='set'){if(k=='escape'||k=='enter')goBack(setBack);return}if(st=='coinc'||st=='train'){if(k=='escape')st='set';return}if(ROOMUI(st)){if(k=='escape')roomEsc();return}if(st=='skin'||st=='maps'||st=='infl'){if(k=='escape')st='menu';return}if(st=='menu'){start();return}if(k=='p'||k=='escape'){if(RM)return;if(st=='play')st='pause';else if(st=='pause')st='play';return}
 if(k=='enter'){e.preventDefault();if(st=='menu'||(st=='over'&&!RM))start();else if(st=='pause')st='play';return}
 if(m[k]&&(S.ctl==0||(S.ctl==1&&k.indexOf('arrow')==0)||(S.ctl==2&&k.length==1))){e.preventDefault();act(m[k])}
});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&st=='play'&&!RM)st='pause'});
let last=0;
function loop(ts){const raw=(ts-last)/1000,dt=M.min(.05,raw||0);last=ts;fN++;fT+=raw||0;if(fT>=.5){fps=M.round(fN/fT);fN=0;fT=0}if(st=='rank'&&T-pollT>4){pollT=T;fetchRank()}T+=dt;upd(dt);musTick();draw();requestAnimationFrame(loop)}
requestAnimationFrame(loop);
</script>
</body>
</html>
