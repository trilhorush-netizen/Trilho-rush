 const k=[[0,1,'\u2190'],[1,1,'\u2192'],[2,0,'\u2191'],[3,1,'\u2193']],pos={0:[bx,by+s+gp],3:[bx+s+gp,by+s+gp],1:[bx+2*(s+gp),by+s+gp],2:[bx+s+gp,by]};
